page {
  background: #f5f7fb;
  color: #172033;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}

.page {
  padding: 24rpx;
}

.card {
  background: #ffffff;
  border: 1rpx solid #dfe5ee;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(20, 34, 54, 0.06);
}

.muted {
  color: #647086;
  font-size: 24rpx;
}

.tag {
  display: inline-flex;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  background: #e9eef5;
  color: #344054;
}

.tag-ok {
  background: #e7f6ee;
  color: #19714d;
}

.tag-warn {
  background: #fff3e6;
  color: #b35c00;
}

.tag-danger {
  background: #fdecec;
  color: #b42318;
}

.btn {
  background: #156f62;
  color: #ffffff;
  border-radius: 10rpx;
  margin-top: 16rpx;
}

.btn-secondary {
  background: #e8edf3;
  color: #172033;
}

.field {
  margin-bottom: 18rpx;
}

.label {
  display: block;
  color: #647086;
  font-size: 24rpx;
  margin-bottom: 8rpx;
}

input,
textarea {
  width: 100%;
  background: #ffffff;
  border: 1rpx solid #dfe5ee;
  border-radius: 10rpx;
  box-sizing: border-box;
  font-size: 30rpx;
  color: #172033;
}

input {
  height: 88rpx;
  min-height: 88rpx;
  line-height: normal;
  padding: 0 20rpx;
}

textarea {
  padding: 18rpx;
  min-height: 130rpx;
  line-height: 1.5;
}

.progress {
  height: 12rpx;
  background: #e7ecf3;
  border-radius: 999rpx;
  overflow: hidden;
  margin: 14rpx 0;
}

.progress-bar {
  height: 100%;
  background: #156f62;
}