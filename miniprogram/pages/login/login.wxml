<view class="page login-page">
  <image class="login-bg" src="/assets/login-workshop.png" mode="aspectFill"></image>
  <view class="login-overlay"></view>
  <view class="card login-card">
    <view class="title">宁波未来机械工单系统</view>
    <view class="muted intro">登录后按岗位进入任务报工、生产看板和异常处理。</view>

    <view class="field">
      <text class="label">公司标识</text>
      <input
        class="text-input"
        value="{{companySlug}}"
        bindinput="onCompanySlug"
        placeholder="请输入公司标识"
        placeholder-class="input-placeholder"
      />
    </view>

    <view class="field">
      <text class="label">手机号</text>
      <input
        class="text-input"
        type="number"
        value="{{phone}}"
        bindinput="onPhone"
        placeholder="请输入手机号"
        placeholder-class="input-placeholder"
      />
    </view>

    <view class="field">
      <text class="label">密码</text>
      <input
        class="text-input"
        value="{{password}}"
        password
        bindinput="onPassword"
        placeholder="请输入密码"
        placeholder-class="input-placeholder"
      />
    </view>

    <button class="btn login-btn" bindtap="submit">登录</button>
  </view>
</view>