.preview-page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 24rpx 24rpx 124rpx;
  background: #f5f7fb;
}

.preview-image {
  display: block;
  width: 100%;
  border-radius: 8rpx;
  background: #ffffff;
}

.preview-error {
  padding: 48rpx 28rpx;
  border-radius: 12rpx;
  background: #ffffff;
  color: #344054;
  box-shadow: 0 2rpx 12rpx rgba(15, 23, 42, 0.08);
}

.preview-error-title {
  margin-bottom: 16rpx;
  color: #b42318;
  font-size: 30rpx;
  font-weight: 800;
}

.preview-error-text {
  font-size: 24rpx;
  line-height: 1.5;
}

.preview-error-url {
  margin-top: 16rpx;
  color: #647086;
  font-size: 20rpx;
  line-height: 1.4;
  word-break: break-all;
}

.download-button {
  position: fixed;
  right: 24rpx;
  bottom: 34rpx;
  z-index: 10;
  width: 132rpx;
  height: 64rpx;
  line-height: 64rpx;
  margin: 0;
  padding: 0;
  border-radius: 10rpx;
  background: #156f62;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
}

.download-button::after {
  border: 0;
}
