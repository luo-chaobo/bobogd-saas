.task-toolbar {
  display: flex;
  align-items: stretch;
  gap: 12rpx;
  margin-bottom: 18rpx;
  width: 100%;
  box-sizing: border-box;
  overflow: hidden;
}

.user-block {
  width: 168rpx;
  flex: 0 0 168rpx;
  border-radius: 12rpx;
  border: 1rpx solid #d4e3df;
  background: #ffffff;
  padding: 16rpx 14rpx;
  box-sizing: border-box;
}

.user-role {
  color: #0f5c51;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.2;
  margin-bottom: 8rpx;
}

.user-name {
  color: #647086;
  font-size: 24rpx;
  line-height: 1.2;
  word-break: break-all;
}

.toolbar-actions {
  flex: 1;
  min-width: 0;
  display: flex;
  gap: 12rpx;
}

.task-name {
  display: -webkit-box;
  min-width: 0;
  margin-bottom: 12rpx;
  overflow: hidden;
  color: #172033;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.35;
  overflow-wrap: anywhere;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.task-meta-grid {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 156rpx 36rpx 104rpx;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 14rpx;
  min-width: 0;
}

.task-order-meta {
  min-width: 0;
  overflow: hidden;
  color: #647086;
  font-size: 24rpx;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.plan-range {
  color: #647086;
  font-size: 22rpx;
  line-height: 1;
  white-space: nowrap;
}

.drawing-preview-icon {
  flex: 0 0 36rpx;
  width: 36rpx;
  min-width: 0;
  max-width: 36rpx;
  height: 36rpx;
  line-height: 32rpx;
  margin: 0;
  padding: 0;
  border: 2rpx solid #d8e2ee;
  border-radius: 8rpx;
  background: #f7fbff;
  color: #2563eb;
  font-size: 24rpx;
  font-weight: 800;
  text-align: center;
  box-sizing: border-box;
  overflow: hidden;
}

.drawing-preview-icon::after {
  border: 0;
}

.drawing-preview-placeholder {
  width: 36rpx;
  height: 36rpx;
}

.task-state {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 104rpx;
  min-width: 104rpx;
  max-width: 104rpx;
  min-height: 44rpx;
  padding: 6rpx 4rpx;
  box-sizing: border-box;
  line-height: 1.2;
  text-align: center;
  white-space: nowrap;
}

.empty {
  text-align: center;
  color: #647086;
}

.actions {
  display: flex;
  gap: 12rpx;
  margin-top: 14rpx;
}

.quality-meta {
  display: flex;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 12rpx;
  color: #0f766e;
  font-size: 22rpx;
}

.mini {
  flex: 1;
  margin-top: 0;
}

.scan-btn {
  flex: 1 1 0;
  width: 0;
  min-width: 0;
  max-width: 100%;
  height: 104rpx;
  line-height: 104rpx;
  padding: 0 10rpx;
  margin: 0;
  font-weight: 700;
  font-size: 30rpx;
  box-sizing: border-box;
}

.logout-btn {
  width: 96rpx;
  flex: 0 0 96rpx;
  height: 104rpx;
  line-height: 104rpx;
  padding: 0;
  margin: 0;
  font-size: 26rpx;
  box-sizing: border-box;
}
.page {
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}